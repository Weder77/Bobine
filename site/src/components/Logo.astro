---
// The app's logo: a small spool and "bobine" in script. `live`: the spool of
// the landing page, which empties as the page goes by (scripts/thread.js).
interface Props {
  href?: string;
  label?: string;
  live?: boolean;
}

const { href = '/', label = 'Bobine, accueil du site', live = false } = Astro.props;
const stripes = [-10, -2, 6, 14, 22, 30, 38];
---

<a class="logo" href={href} aria-label={label}>
  <svg aria-hidden="true" width="22" height="32" viewBox="0 0 22 32">
    {
      live && (
        <defs>
          <clipPath id="mini-clip">
            <rect data-spool="mini-clip" x="3" y="5" width="16" height="22" />
          </clipPath>
        </defs>
      )
    }
    <rect data-spool={live ? 'mini-body' : undefined} x="3" y="5" width="16" height="22" fill="#ff5a36"></rect>
    {
      live ? (
        <g clip-path="url(#mini-clip)">
          <g data-spool="mini-stripes" stroke="#b83a1d" stroke-width="1.6">
            {stripes.map((y) => (
              <path d={`M0 ${y} L22 ${y - 6}`} />
            ))}
          </g>
        </g>
      ) : (
        <g stroke="#b83a1d" stroke-width="1.6">
          <path d="M3 14 L19 9" />
          <path d="M3 22 L19 17" />
        </g>
      )
    }
    <rect x="0" y="0" width="22" height="5" rx="1.5" fill="#f3eee8"></rect>
    <rect x="0" y="27" width="22" height="5" rx="1.5" fill="#f3eee8"></rect>
  </svg>
  <span class="logo__word" aria-hidden="true">bobine</span>
</a>
