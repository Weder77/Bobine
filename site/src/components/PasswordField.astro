---
// A password field with its "show" button. No `name`: without the page's
// script nothing is sent anywhere (the CSP also forbids form submission).
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  placeholder?: string;
  minlength?: number;
}

const { id, label, autocomplete, placeholder, minlength } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class="field">
  {
    hasAside ? (
      <div class="field__head">
        <label for={id}>{label}</label>
        <slot name="aside" />
      </div>
    ) : (
      <label for={id}>{label}</label>
    )
  }
  <div class="password">
    <input class="input" id={id} type="password" autocomplete={autocomplete} placeholder={placeholder} minlength={minlength} required />
    <button class="password__toggle" type="button" data-toggle-password aria-label="Afficher le mot de passe" aria-pressed="false">
      <Icon name="eye" size={20} />
    </button>
  </div>
</div>
